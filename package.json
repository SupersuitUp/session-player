{
  "name": "@supersuit/simulator",
  "version": "0.3.2",
  "description": "Renamed to @supersuit/session-player. Plays recorded agent sessions (case studies) on a simulated phone or MacBook.",
  "type": "module",
  "bin": {
    "simulator": "bin/simulator.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./player": "./src/player.mjs",
    "./embed": "./src/embed.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/simulator.git"
  },
  "keywords": [
    "supersuit",
    "simulator",
    "claude-code",
    "agents",
    "replay"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
